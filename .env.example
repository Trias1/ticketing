# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string (use the pooled one, host contains -pooler).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random string, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=

# Cloudinary, for avatars and images pasted into issues.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: public demo (see docs/self-hosting.md, "Running a public demo").
# Only on a separate demo deployment with its own empty database:
# NEXT_PUBLIC_DEMO_MODE=1
# CRON_SECRET=
# On the main instance, to link to the demo from the home page:
# NEXT_PUBLIC_DEMO_URL=https://your-demo.vercel.app
